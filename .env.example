# Port HTTP du backend Node.js
PORT=3000

# URL du service AI Core
AI_CORE_URL=http://localhost:8001

# URL de base de données Prisma, à définir selon le moteur utilisé
# DATABASE_URL=file:./dev.db

# Clé Jina Reader (laisser vide pour l’accès public à faible volume)
# JINA_API_KEY=
# RAG_URL_TIMEOUT_MS=30000

# Connexion en lecture seule dédiée aux sources SQL RAG
# PostgreSQL : RAG_SQL_DRIVER=postgres
# RAG_SQL_DATABASE_URL=postgresql://rag_reader:password@db.example.com:5432/core
# MariaDB/MySQL : utiliser une URL accessible depuis le backend, jamais 127.0.0.1 si la base tourne sur un autre ordinateur
# RAG_SQL_DRIVER=mysql
# RAG_SQL_DATABASE_URL=mysql://lecteur:mot_de_passe@db.example.com:3306/gpr_sicma_online
# RAG_SQL_SSL=false
# Limites de sécurité communes
# RAG_SQL_POOL_SIZE=2
# RAG_SQL_MAX_ROWS=1000
# Presets JSON : uniquement des requêtes SELECT/CTE administrées, jamais une requête fournie par le navigateur
# RAG_SQL_PRESETS={"gpr_gps_claim":{"driver":"mysql","name":"Réclamations GPS Claim","knowledge_base_id":"demo-gpr-regulatory-kb","source_table":"gps_claim","primary_key":"id","max_rows":1000,"query":"SELECT id, code, content, status, type, created_at, updated_at, ai_suggested_category, ai_suggested_motif, ai_urgency, ai_sentiment, ai_summary FROM gps_claim WHERE COALESCE(is_deleted, 0) = 0 ORDER BY updated_at DESC LIMIT 1000"}}
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120
