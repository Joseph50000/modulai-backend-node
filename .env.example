# Port HTTP du backend Node.js
PORT=3000

# URL du service AI Core
AI_CORE_URL=http://localhost:8001

# URL de base de données Prisma, à définir selon le moteur utilisé
# DATABASE_URL=file:./dev.db

# Clé Jina Reader (laisser vide pour l’accès public à faible volume)
# JINA_API_KEY=
# RAG_URL_TIMEOUT_MS=30000

# Connexion en lecture seule dédiée aux sources SQL RAG
# RAG_SQL_DATABASE_URL=postgresql://rag_reader:password@db.example.com:5432/core
# RAG_SQL_SSL=true
# Presets JSON : uniquement des requêtes administrées, jamais une requête fournie par le navigateur
# RAG_SQL_PRESETS={"gpr_claims":{"name":"Réclamations GPR","knowledge_base_id":"demo-gpr-regulatory-kb","source_table":"gpr_claims_for_rag","primary_key":"claim_id","query":"SELECT claim_id, category, status, amount, summary FROM gpr_claims_for_rag WHERE updated_at >= NOW() - INTERVAL '7 days'"}}
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120
